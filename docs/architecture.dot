// CoGrind project architecture
//
// Render with:
//   dot -Tsvg docs/architecture.dot -o docs/architecture.svg
//   dot -Tpng docs/architecture.dot -o docs/architecture.png
//
// Scope: the seven ParkviewLab repos that make up CoGrind, the on-disk
// state each owns, the external services they talk to, and the
// architecturally-significant library dependencies. Transitive deps and
// internal modules are intentionally omitted — this is a map of the
// pieces, not a full call graph.

digraph CoGrind {
    rankdir=LR;
    compound=true;
    newrank=true;
    fontname="Helvetica";
    node  [fontname="Helvetica", fontsize=10];
    edge  [fontname="Helvetica", fontsize=9];

    // ───────────────────────────────────────────────────────────────────
    // Human + external surface (left edge)
    // ───────────────────────────────────────────────────────────────────
    human [label="Human user", shape=oval, style=filled, fillcolor="#fff2cc"];

    subgraph cluster_external {
        label="External services";
        style="dashed";
        color="#888888";
        fontcolor="#555555";

        anthropic [label="Anthropic API\n(claude-opus-4-7)",
                   shape=cloud, style=filled, fillcolor="#e8e8ff"];
        github    [label="GitHub / arbitrary URLs\n(git clone, HTTPS PDF fetch)",
                   shape=cloud, style=filled, fillcolor="#e8e8ff"];
    }

    // ───────────────────────────────────────────────────────────────────
    // ParkviewLab repos (the code)
    // ───────────────────────────────────────────────────────────────────
    subgraph cluster_repos {
        label="ParkviewLab repos";
        style="rounded,filled";
        fillcolor="#f6f6f6";
        color="#cccccc";

        // MCP client (the human-facing CLI)
        workshop [label="cogrind-workshop\nCLI / REPL\n(MCP client)",
                  shape=box, style="rounded,filled", fillcolor="#d5e8d4"];

        // MCP host + server (the orchestrator)
        cobalt   [label=<<b>cobalt-grinding</b><br/>MCP host + MCP server<br/>(daemon, supervisor,<br/>ingest + retrieve + converse)>,
                  shape=box, style="rounded,filled", fillcolor="#dae8fc",
                  width=2.4];

        // Spawned MCP child servers
        smalt   [label="smalt-mcp\n(wiki storage substrate)",
                 shape=box, style="rounded,filled", fillcolor="#ffe6cc"];
        ebony   [label="ebony-enriching\n(lab notebook substrate)",
                 shape=box, style="rounded,filled", fillcolor="#ffe6cc"];
        deco    [label="deco-assaying\n(tree-sitter code parser)",
                 shape=box, style="rounded,filled", fillcolor="#ffe6cc"];
        flint   [label="flint-slating\n(PDF reader)",
                 shape=box, style="rounded,filled", fillcolor="#ffe6cc"];

        // Shared cross-repo tooling
        devtools [label="dev-tools\n(git-bump, git-release,\nshared release scripts)",
                  shape=note, style=filled, fillcolor="#f5f5f5"];
    }

    // ───────────────────────────────────────────────────────────────────
    // On-disk state surfaces (each owned by exactly one process)
    // ───────────────────────────────────────────────────────────────────
    subgraph cluster_state {
        label="On-disk state";
        style="dashed";
        color="#888888";
        fontcolor="#555555";

        smalt_dir [label="SMALT_DIR\n~/Documents/Smalt/\n  pages/*.md\n  lance/  (wiki vectors + BM25)",
                   shape=folder, style=filled, fillcolor="#fff2cc"];
        ebony_dir [label="EBONY_ENRICHING_DIR\n~/Documents/EbonyEnriching/\n  (markdown notebook;\n   no DB, no embedder)",
                   shape=folder, style=filled, fillcolor="#fff2cc"];
        cg_dir    [label="cobalt_grinding_dir\n~/.local/state/cobalt_grinding/\n  tools_index/  (lance store of\n   MCP child tool descriptions)",
                   shape=folder, style=filled, fillcolor="#fff2cc"];
        flint_cache [label="flint cache dir\n(content-addressed PDF\n + extraction cache;\n  path is flint-internal)",
                     shape=folder, style=filled, fillcolor="#fff2cc"];
    }

    // ───────────────────────────────────────────────────────────────────
    // Architecturally-significant library dependencies
    // (only the ones that shape what each process *is* — not transitive
    //  noise. uvicorn/Starlette/FastAPI are listed once as the shared
    //  HTTP transport rather than redrawn per server.)
    // ───────────────────────────────────────────────────────────────────
    subgraph cluster_libs {
        label="Major library dependencies";
        style="dashed";
        color="#888888";
        fontcolor="#555555";

        mcp_lib       [label="mcp[cli]\n(MCP protocol;\n stdio + streamable-http)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        http_stack    [label="uvicorn + Starlette\n+ FastAPI\n(HTTP transport,\n shared by all servers)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        lancedb       [label="LanceDB\n(vector + BM25 store)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        fastembed     [label="fastembed\n(local embedding model)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        anthropic_sdk [label="anthropic SDK\n(>=0.97,<1.0)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        treesitter    [label="tree-sitter\n+ tree-sitter-language-pack",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        pdf_stack     [label="docling + pypdf\n+ pdfplumber\n(torch CPU)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        repl_stack    [label="prompt_toolkit\n+ Rich + Click + httpx",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
        git_cli       [label="git CLI\n(subprocess, for\n URL repo ingest)",
                       shape=component, style=filled, fillcolor="#f0f0f0"];
    }

    // ───────────────────────────────────────────────────────────────────
    // Edges
    // ───────────────────────────────────────────────────────────────────

    // Human → CLI → host
    human    -> workshop [label="types in REPL\n(/ingest, /ask, ...)"];
    workshop -> cobalt   [label="MCP / streamable-http\n(wiki.* tool calls)", color="#2e7d32", penwidth=1.6];

    // Host → spawned MCP children (process supervision + tool calls)
    cobalt -> smalt [label="spawn + supervise\nMCP / stdio", color="#1565c0", penwidth=1.6];
    cobalt -> ebony [label="spawn + supervise\nMCP / stdio", color="#1565c0", penwidth=1.6];
    cobalt -> deco  [label="spawn + supervise\nMCP / stdio", color="#1565c0", penwidth=1.6];
    cobalt -> flint [label="spawn + supervise\nMCP / stdio", color="#1565c0", penwidth=1.6];

    // wiki.* surface composition: cobalt-grinding's public tools delegate
    // into the children. Drawn as a single annotation per child so the
    // graph doesn't explode into one edge per tool.
    //   wiki.search / get_page / traverse / find_gaps / report_gap → smalt + ebony
    //   wiki.ingest (code paths)                                   → deco
    //   wiki.ingest (PDF paths)                                    → flint
    //   wiki.ask                                                   → smalt + anthropic

    // Host → external services
    cobalt -> anthropic [label="HTTPS\n(wiki.ask + ingest\n sub-agents)", style=dashed];
    cobalt -> github    [label="git clone --depth 1\n(URL → tempdir,\n for repo ingest)", style=dashed];

    // Flint fetches PDF URLs directly (host hands it the URL, not bytes)
    flint -> github [label="HTTPS\n(PDF URL fetch)", style=dashed];

    // Storage ownership: each substrate owns exactly one on-disk surface
    smalt   -> smalt_dir   [label="owns / read+write", style=bold, color="#bf5700"];
    ebony   -> ebony_dir   [label="owns / read+write", style=bold, color="#bf5700"];
    cobalt  -> cg_dir      [label="owns / read+write\n(tools_index lance)", style=bold, color="#bf5700"];
    flint   -> flint_cache [label="owns / read+write", style=bold, color="#bf5700"];

    // dev-tools: shared scripts, installed via its install.sh into
    // ~/.local/bin/ and used from every repo's worktree.
    devtools -> cobalt   [label="git-bump,\ngit-release", style=dotted, arrowhead=odot, color="#888888"];
    devtools -> workshop [style=dotted, arrowhead=odot, color="#888888"];
    devtools -> smalt    [style=dotted, arrowhead=odot, color="#888888"];
    devtools -> ebony    [style=dotted, arrowhead=odot, color="#888888"];
    devtools -> deco     [style=dotted, arrowhead=odot, color="#888888"];
    devtools -> flint    [style=dotted, arrowhead=odot, color="#888888"];

    // ───────────────────────────────────────────────────────────────────
    // Library edges (dotted, grey — they're context, not data flow)
    // ───────────────────────────────────────────────────────────────────
    edge [style=dotted, color="#999999", arrowhead=none, fontcolor="#777777"];

    // MCP protocol library — every server + the CLI client
    workshop -> mcp_lib;
    cobalt   -> mcp_lib;
    smalt    -> mcp_lib;
    ebony    -> mcp_lib;
    deco     -> mcp_lib;
    flint    -> mcp_lib;

    // HTTP transport — every server that exposes streamable-http
    cobalt -> http_stack;
    smalt  -> http_stack;
    ebony  -> http_stack;
    deco   -> http_stack;
    flint  -> http_stack;

    // LanceDB — smalt-mcp (wiki) and cobalt-grinding (tools_index).
    // Two separate processes, two separate lance dirs, never shared.
    cobalt -> lancedb [label="tools_index"];
    smalt  -> lancedb [label="wiki"];

    // fastembed — same split as LanceDB
    cobalt -> fastembed [label="tools_index"];
    smalt  -> fastembed [label="wiki"];

    // Anthropic SDK only lives in cobalt-grinding
    cobalt -> anthropic_sdk;

    // Per-server specialised stacks
    deco  -> treesitter;
    flint -> pdf_stack;

    // CLI / REPL stack
    workshop -> repl_stack;

    // git CLI is invoked from cobalt-grinding's ingest path
    cobalt -> git_cli;

    // ───────────────────────────────────────────────────────────────────
    // Layout hints
    // ───────────────────────────────────────────────────────────────────
    { rank=same; human; workshop; }
    { rank=same; smalt_dir; ebony_dir; cg_dir; flint_cache; }
}
